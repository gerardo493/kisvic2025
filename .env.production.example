# Copia a .env.production y completa desde Firebase Console:
# Proyecto kisvic-facturacion > Configuracion del proyecto > Tus apps > Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kisvic-facturacion.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kisvic-facturacion
VITE_FIREBASE_STORAGE_BUCKET=kisvic-facturacion.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_OFFICIAL_HOSTS=kisvic-facturacion.web.app,kisvic-facturacion.firebaseapp.com
# Opcional: URL del backend Flask para dashboard real
# Ejemplo: https://tu-tunel.trycloudflare.com/api/dashboard/resumen
VITE_DASHBOARD_API_URL=

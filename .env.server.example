KISVIC_ENV=development
KISVIC_SECRET_KEY=cambia_esto_por_una_clave_larga_y_privada
# 1 si usas HTTPS real (Cloud Run/producción), 0 en local
KISVIC_COOKIE_SECURE=0
KISVIC_CSRF_MODE=phase1
# Endpoints protegidos en phase1 (separados por coma)
KISVIC_CSRF_PROTECTED_ENDPOINTS=login
# Persistencia:
# - firebase_primary (recomendado)
# - local_primary
# - local_only
KISVIC_STORAGE_MODE=firebase_primary
# Observabilidad
KISVIC_LOG_LEVEL=INFO
# Opcional: webhook para alertas críticas (Slack/Discord/otro)
KISVIC_ALERT_WEBHOOK_URL=

# Lanzador kisvic.py
KISVIC_USE_FIREBASE=1
KISVIC_VERIFICAR_FIREBASE=1
# 1 = backup antes de cada arranque (python kisvic.py run)
KISVIC_AUTO_BACKUP=0
KISVIC_PORT=5000

